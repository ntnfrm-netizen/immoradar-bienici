# ImmoRadar — variables d'environnement
# À configurer sur Netlify : Site settings → Environment variables
# Ne PAS commiter le vrai fichier .env (déjà dans .gitignore)

# ─── Google AI Studio (Gemini) ───
# Générer sur https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# ─── Gmail API (OAuth 2.0) ───
# Projet Google Cloud avec Gmail API activée
# Credentials → OAuth 2.0 Client (type "Desktop")
GMAIL_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxx

# Refresh token (obtenu une fois via : npm run get-token)
GMAIL_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Adresse email à scanner (la boite Gmail de Marie Astrid)
GMAIL_USER=marie.astrid@gmail.com
